# Canonical, executable model mapping for scripts/agent-launch.
# Empty values are deliberate: an unavailable provider/model fails closed.
#
# Owner policy directive 2026-08-31 (supersedes the previous matrix):
# - Orchestrator: deepseek-v4-flash
# - Coding (normal/complex): kimi-k2.7-code
# - Independent review (default): qwen3.8-flash; MAX is ESCALATION-ONLY
# - LOW / visual / CSS / copy: Cursor Composer 2.5 (fallback mimo-v2.5)
# - HIGH_CODING fallback: Cursor Grok 4.6 medium (only after Kimi fails twice
#   on the SAME bounded task; never through OpenCode Go)
# - HIGH_ARCHITECTURE: deepseek-v4-pro (fresh escalation session, escalation only)

LOW_CURSOR_MODEL=composer-2.5
LOW_OPENCODE_MODEL=opencode-go/mimo-v2.5

MEDIUM_CURSOR_MODEL=composer-2.5
MEDIUM_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
MEDIUM_FALLBACK_OPENCODE_MODEL=opencode-go/qwen3.8-flash

MEDIUM_HIGH_CURSOR_MODEL=cursor-grok-4.6-medium
MEDIUM_HIGH_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
MEDIUM_HIGH_FALLBACK_OPENCODE_MODEL=opencode-go/kimi-k2.7-code

HIGH_CODING_CURSOR_MODEL=cursor-grok-4.6-medium
HIGH_CODING_OPENCODE_MODEL=opencode-go/kimi-k2.7-code

# Chat turn / agent lifecycle / response correlation author (owner directive
# 2026-09-02, Cursor quota exhausted): one strong bounded author pass on
# chat-turn causality using GPT-5.6 Luna over OpenCode Go. Not a default; used
# only for this explicit bounded task assignment.
HIGH_CODING_LUNA_OPENCODE_MODEL=opencode-go/gpt-5.6-luna

# High visual / interaction design task author (explicit owner task assignment
# UX_REDESIGN_01 correction pass): Cursor Grok 4.6 High, used only through the
# Cursor provider, never through OpenCode Go.
HIGH_VISUAL_CURSOR_MODEL=cursor-grok-4.6-high

# Default independent reviewer (Qwen3.8 Flash). HIGH_REVIEW is ESCALATION-ONLY:
# the orchestrator must record an explicit ESCALATION_REASON before using it.
REVIEW_OPENCODE_MODEL=opencode-go/qwen3.8-flash
HIGH_REVIEW_OPENCODE_MODEL=opencode-go/qwen3.8-max

HIGH_ARCHITECTURE_OPENCODE_MODEL=opencode-go/deepseek-v4-pro