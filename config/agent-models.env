# Canonical, executable model mapping for scripts/agent-launch.
# Empty values are deliberate: an unavailable provider/model fails closed.

LOW_CURSOR_MODEL=composer-2.5
LOW_OPENCODE_MODEL=opencode-go/mimo-v2.5

MEDIUM_CURSOR_MODEL=composer-2.5
MEDIUM_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
MEDIUM_FALLBACK_OPENCODE_MODEL=opencode-go/qwen3.8-max

MEDIUM_HIGH_CURSOR_MODEL=cursor-grok-4.6-medium
MEDIUM_HIGH_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
MEDIUM_HIGH_FALLBACK_OPENCODE_MODEL=opencode-go/kimi-k2.7-code
HIGH_CODING_CURSOR_MODEL=cursor-grok-4.6-medium
HIGH_CODING_OPENCODE_MODEL=opencode-go/kimi-k2.7-code

HIGH_ARCHITECTURE_OPENCODE_MODEL=opencode-go/deepseek-v4-pro
