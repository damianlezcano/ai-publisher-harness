#!/usr/bin/env bash
# Offline contracts for the two official distribution tracks.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

fail() { echo "test-distribution-contracts: FAIL: $*" >&2; exit 1; }
python3 - <<'PY'
import json
from pathlib import Path

components = json.loads(Path("config/components.json").read_text())["components"]
for platform, expected in {
    "linux-x86_64": {"opencode", "cloudflared"},
    "windows-x86_64": {"opencode", "cloudflared"},
}.items():
    actual = {c["name"] for c in components if c["platform"] == platform}
    if actual != expected:
        raise SystemExit(f"{platform}: expected {expected}, got {actual}")
    for c in (c for c in components if c["platform"] == platform):
        if len(c["sha256"]) != 64:
            raise SystemExit(f"{platform}/{c['name']}: invalid checksum")

tauri = json.loads(Path("app/src-tauri/tauri.conf.json").read_text())
if "nsis" not in tauri["bundle"]["targets"]:
    raise SystemExit("Tauri NSIS target is missing")
PY
python3 - <<'PY'
import re
from pathlib import Path

cf = Path("packaging/linux/Containerfile").read_text()
if "ARG NODE_VERSION=22.14.0" not in cf:
    raise SystemExit("Containerfile: NODE_VERSION must stay pinned at 22.14.0")
statements = re.split(r"\n(?=FROM|RUN|ENV|ARG|COPY)", cf)
node_stmts = [s for s in statements if "nodejs.org/dist" in s and "corepack enable" in s]
if len(node_stmts) != 1:
    raise SystemExit("Containerfile: expected exactly one pinned-Node + corepack-enable RUN")
node_run = node_stmts[0]
for name in ("node", "npm", "npx", "corepack"):
    link = f"ln -s /opt/node-v${{NODE_VERSION}}-linux-x64/bin/{name} /usr/local/bin/{name}"
    if link not in node_run:
        raise SystemExit(f"Containerfile: /usr/local/bin/{name} must be linked from the pinned Node distribution")
if node_run.index("/usr/local/bin/corepack") > node_run.index("corepack enable"):
    raise SystemExit("Containerfile: corepack enable must run after the corepack symlink")
if "RUSTUP_HOME=/opt/rustup" not in cf or "CARGO_HOME=/opt/cargo" not in cf:
    raise SystemExit("Containerfile: Rust homes must live in /opt for the keep-id run user")
if "/opt/cargo/bin" not in cf:
    raise SystemExit("Containerfile: PATH must expose /opt/cargo/bin")
if "/root/.cargo" in cf:
    raise SystemExit("Containerfile: must not rely on /root/.cargo (keep-id run cannot read root's home)")
if "tauri-cli" not in cf or "--version 2.11.4" not in cf or "/opt/tauri-cli" not in cf:
    raise SystemExit("Containerfile: Tauri CLI must be pinned and installed into /opt/tauri-cli")
if "/opt/tauri-cli/bin" not in cf:
    raise SystemExit("Containerfile: PATH must expose /opt/tauri-cli/bin")
PY
rg -Fq 'ubuntu:24.04' packaging/linux/Containerfile || fail 'Ubuntu 24.04 controlled build image missing'
rg -Fq 'export CI=true' packaging/linux/build-linux-appimage || fail 'Linux controlled build must be non-interactive (CI=true)'
rg -Fq 'x86_64-pc-windows-msvc' packaging/windows/build.ps1 || fail 'Windows MSVC sidecar contract missing'
echo 'test-distribution-contracts: PASS'
