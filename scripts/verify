#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

failures=0

fail() {
  printf 'verify: FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

require_file() {
  [[ -f "$1" ]] || fail "missing required file: $1"
}

require_heading() {
  local file="$1"
  local heading="$2"
  rg -Fq "$heading" "$file" || fail "missing heading '$heading' in $file"
}

for file in \
  CODEX_HANDOFF.md AGENTS.md README.md \
  docs/PRODUCT.md docs/ARCHITECTURE.md docs/SECURITY.md docs/UX.md \
  docs/DEFINITION_OF_DONE.md docs/TESTING.md docs/VERIFY.md \
  docs/WORKTREES.md docs/MULTI_AGENT_WORKFLOW.md docs/HARNESS_REVIEW.md \
  docs/decisions/README.md \
  skills/implement-feature/SKILL.md skills/review-feature/SKILL.md \
  skills/review-architecture/SKILL.md skills/verify-ui/SKILL.md; do
  require_file "$file"
done

for script in scripts/bootstrap scripts/verify scripts/agent-launch scripts/test-agent-launch; do
  [[ -x "$script" ]] || fail "script is not executable: $script"
  bash -n "$script" || fail "shell syntax check failed: $script"
done

require_heading docs/TESTING.md '## Required test levels'
require_heading docs/VERIFY.md '## Contract by milestone'
require_heading docs/WORKTREES.md '## Checkout ownership'
require_heading docs/MULTI_AGENT_WORKFLOW.md '## Herdr delegation'
require_heading docs/HARNESS_REVIEW.md '## Resolved gaps'

printf 'verify: scripts/test-agent-launch\n'
./scripts/test-agent-launch

if rg -n -i 'place[h]older|to[d]o|tb[d]' scripts/verify skills/*/SKILL.md; then
  fail 'M0 verification and skills must not contain unresolved markers'
fi

if (( failures > 0 )); then
  printf 'verify: %d harness contract failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'verify: M0 harness contract passed\n'

for file in Cargo.toml Cargo.lock rust-toolchain.toml; do
  [[ -f "$file" ]] || fail "missing required Rust workspace file: $file"
done

if (( failures > 0 )); then
  printf 'verify: %d M1 bootstrap contract failure(s)\n' "$failures" >&2
  exit 1
fi

for command in cargo rustfmt cargo-clippy; do
  if ! command -v "$command" >/dev/null 2>&1; then
    fail "required M1 Rust command is unavailable: $command"
  fi
done

if (( failures > 0 )); then
  printf 'verify: %d M1 Rust toolchain prerequisite failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'verify: cargo fmt --all -- --check\n'
cargo fmt --all -- --check

printf 'verify: cargo clippy --locked --workspace --all-targets -- -D warnings\n'
cargo clippy --locked --workspace --all-targets -- -D warnings

printf 'verify: cargo test --locked --workspace --all-targets\n'
cargo test --locked --workspace --all-targets

if [[ -f crates/project-fs/tests/project_lifecycle.rs ]]; then
  printf 'verify: cargo test --locked -p project-fs --test project_lifecycle\n'
  cargo test --locked -p project-fs --test project_lifecycle
else
  printf 'verify: SKIP: project-fs filesystem integration suite is not introduced yet\n'
fi

if [[ -f crates/project-publisher/tests/publisher_http.rs ]]; then
  printf 'verify: cargo test --locked -p project-publisher --test publisher_http\n'
  cargo test --locked -p project-publisher --test publisher_http
fi

if [[ -f crates/project-publisher/tests/publisher_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-publisher --test publisher_security\n'
  cargo test --locked -p project-publisher --test publisher_security
fi

if [[ -f crates/project-publication/tests/publication_lifecycle.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_lifecycle\n'
  cargo test --locked -p project-publication --test publication_lifecycle
fi

if [[ -f crates/project-publication/tests/publication_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_security\n'
  cargo test --locked -p project-publication --test publication_security
fi

if [[ -f crates/project-fs/tests/project_migration.rs ]]; then
  printf 'verify: cargo test --locked -p project-fs --test project_migration\n'
  cargo test --locked -p project-fs --test project_migration
fi

if [[ -f crates/project-tunnel/tests/models.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test models\n'
  cargo test --locked -p project-tunnel --test models
fi

if [[ -f crates/project-tunnel/tests/supervisor.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test supervisor\n'
  cargo test --locked -p project-tunnel --test supervisor
fi

if [[ -f crates/project-tunnel/tests/cloudflare.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test cloudflare\n'
  cargo test --locked -p project-tunnel --test cloudflare
fi

if [[ -f crates/project-tunnel/tests/tunnel_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test tunnel_security\n'
  cargo test --locked -p project-tunnel --test tunnel_security
fi

if [[ -f crates/project-publication/tests/publication_tunnel.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_tunnel\n'
  cargo test --locked -p project-publication --test publication_tunnel
fi

printf 'verify: git diff --check\n'
git diff --check

if [[ -f crates/project-publication/tests/publication_tunnel.rs ]]; then
  printf 'verify: M4 contract passed\n'
elif [[ -f crates/project-publication/tests/publication_lifecycle.rs ]]; then
  printf 'verify: M3 contract passed\n'
elif [[ -f crates/project-publisher/tests/publisher_http.rs ]]; then
  printf 'verify: M2 contract passed\n'
else
  printf 'verify: M1 contract passed\n'
fi
