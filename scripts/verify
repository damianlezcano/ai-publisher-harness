#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

failures=0

fail() {
  printf 'verify: FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

require_file() {
  [[ -f "$1" ]] || fail "missing required file: $1"
}

require_heading() {
  local file="$1"
  local heading="$2"
  rg -Fq "$heading" "$file" || fail "missing heading '$heading' in $file"
}

for file in \
  CODEX_HANDOFF.md AGENTS.md README.md \
  docs/PRODUCT.md docs/ARCHITECTURE.md docs/SECURITY.md docs/UX.md \
  docs/DEFINITION_OF_DONE.md docs/TESTING.md docs/VERIFY.md \
  docs/WORKTREES.md docs/MULTI_AGENT_WORKFLOW.md docs/HARNESS_REVIEW.md \
  docs/decisions/README.md \
  skills/implement-feature/SKILL.md skills/review-feature/SKILL.md \
  skills/review-architecture/SKILL.md skills/verify-ui/SKILL.md; do
  require_file "$file"
done

for script in scripts/bootstrap scripts/verify scripts/agent-launch scripts/test-agent-launch scripts/check-session-budget scripts/test-session-budget scripts/fetch-sidecars scripts/check-appimage-glibc scripts/test-distribution-contracts scripts/package; do
  [[ -x "$script" ]] || fail "script is not executable: $script"
  bash -n "$script" || fail "shell syntax check failed: $script"
done

require_heading docs/TESTING.md '## Required test levels'
require_heading docs/VERIFY.md '## Contract by milestone'
require_heading docs/WORKTREES.md '## Checkout ownership'
require_heading docs/MULTI_AGENT_WORKFLOW.md '## Herdr delegation'
require_heading docs/HARNESS_REVIEW.md '## Resolved gaps'

printf 'verify: scripts/test-agent-launch\n'
./scripts/test-agent-launch

printf 'verify: scripts/test-session-budget\n'
./scripts/test-session-budget

if rg -n -i 'place[h]older|to[d]o|tb[d]' scripts/verify skills/*/SKILL.md; then
  fail 'M0 verification and skills must not contain unresolved markers'
fi

if (( failures > 0 )); then
  printf 'verify: %d harness contract failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'verify: M0 harness contract passed\n'

for file in Cargo.toml Cargo.lock rust-toolchain.toml; do
  [[ -f "$file" ]] || fail "missing required Rust workspace file: $file"
done

if (( failures > 0 )); then
  printf 'verify: %d M1 bootstrap contract failure(s)\n' "$failures" >&2
  exit 1
fi

for command in cargo rustfmt cargo-clippy; do
  if ! command -v "$command" >/dev/null 2>&1; then
    fail "required M1 Rust command is unavailable: $command"
  fi
done

if (( failures > 0 )); then
  printf 'verify: %d M1 Rust toolchain prerequisite failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'verify: cargo fmt --all -- --check\n'
cargo fmt --all -- --check

printf 'verify: cargo clippy --locked --workspace --all-targets -- -D warnings\n'
cargo clippy --locked --workspace --all-targets -- -D warnings

printf 'verify: cargo test --locked --workspace --all-targets\n'
cargo test --locked --workspace --all-targets

if [[ -f crates/project-fs/tests/project_lifecycle.rs ]]; then
  printf 'verify: cargo test --locked -p project-fs --test project_lifecycle\n'
  cargo test --locked -p project-fs --test project_lifecycle
else
  printf 'verify: SKIP: project-fs filesystem integration suite is not introduced yet\n'
fi

if [[ -f crates/project-publisher/tests/publisher_http.rs ]]; then
  printf 'verify: cargo test --locked -p project-publisher --test publisher_http\n'
  cargo test --locked -p project-publisher --test publisher_http
fi

if [[ -f crates/project-publisher/tests/publisher_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-publisher --test publisher_security\n'
  cargo test --locked -p project-publisher --test publisher_security
fi

if [[ -f crates/project-publication/tests/publication_lifecycle.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_lifecycle\n'
  cargo test --locked -p project-publication --test publication_lifecycle
fi

if [[ -f crates/project-publication/tests/publication_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_security\n'
  cargo test --locked -p project-publication --test publication_security
fi

if [[ -f crates/project-fs/tests/project_migration.rs ]]; then
  printf 'verify: cargo test --locked -p project-fs --test project_migration\n'
  cargo test --locked -p project-fs --test project_migration
fi

if [[ -f crates/project-tunnel/tests/models.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test models\n'
  cargo test --locked -p project-tunnel --test models
fi

if [[ -f crates/project-tunnel/tests/supervisor.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test supervisor\n'
  cargo test --locked -p project-tunnel --test supervisor
fi

if [[ -f crates/project-tunnel/tests/cloudflare.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test cloudflare\n'
  cargo test --locked -p project-tunnel --test cloudflare
fi

if [[ -f crates/project-tunnel/tests/tunnel_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-tunnel --test tunnel_security\n'
  cargo test --locked -p project-tunnel --test tunnel_security
fi

if [[ -f crates/project-publication/tests/publication_tunnel.rs ]]; then
  printf 'verify: cargo test --locked -p project-publication --test publication_tunnel\n'
  cargo test --locked -p project-publication --test publication_tunnel
fi

if [[ -f crates/project-process/tests/supervisor.rs ]]; then
  printf 'verify: cargo test --locked -p project-process --test supervisor\n'
  cargo test --locked -p project-process --test supervisor
fi

if [[ -f crates/project-agent/tests/models.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test models\n'
  cargo test --locked -p project-agent --test models
fi

if [[ -f crates/project-agent/tests/opencode_adapter.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test opencode_adapter\n'
  cargo test --locked -p project-agent --test opencode_adapter
fi

if [[ -f crates/project-agent/tests/agent_service.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test agent_service\n'
  cargo test --locked -p project-agent --test agent_service
fi

if [[ -f crates/project-agent/tests/agent_security.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test agent_security\n'
  cargo test --locked -p project-agent --test agent_security
fi

if [[ -f crates/project-agent/tests/agent_lifecycle.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test agent_lifecycle\n'
  cargo test --locked -p project-agent --test agent_lifecycle
fi

if [[ -f crates/project-agent/tests/agent_attachment.rs ]]; then
  printf 'verify: cargo test --locked -p project-agent --test agent_attachment\n'
  cargo test --locked -p project-agent --test agent_attachment
fi

# --- M6: project-app application facade --------------------------------------

if [[ -f crates/project-app/tests/app_facade.rs ]]; then
  printf 'verify: cargo test --locked -p project-app --all-targets\n'
  cargo test --locked -p project-app --all-targets
fi

# --- M8: project-app named suites --------------------------------------------

for suite in materials attachments preview; do
  if [[ -f "crates/project-app/tests/$suite.rs" ]]; then
    printf 'verify: cargo test --locked -p project-app --test %s\n' "$suite"
    cargo test --locked -p project-app --test "$suite"
  fi
done

# --- M8: project-preview security + lifecycle --------------------------------

for suite in preview_security preview_lifecycle; do
  if [[ -f "crates/project-preview/tests/$suite.rs" ]]; then
    printf 'verify: cargo test --locked -p project-preview --test %s\n' "$suite"
    cargo test --locked -p project-preview --test "$suite"
  fi
done

# --- M7: provider/model surface -----------------------------------------------

if [[ -f crates/project-opencode/src/lib.rs ]]; then
  printf 'verify: cargo test --locked -p project-opencode --all-targets\n'
  cargo test --locked -p project-opencode --all-targets
fi

for suite in provider_models provider_adapter provider_service provider_security provider_lifecycle; do
  if [[ -f "crates/project-provider/tests/$suite.rs" ]]; then
    printf 'verify: cargo test --locked -p project-provider --test %s\n' "$suite"
    cargo test --locked -p project-provider --test "$suite"
  fi
done

# --- M6: frontend toolchain --------------------------------------------------

if [[ -d app ]]; then
  if ! command -v pnpm >/dev/null 2>&1; then
    printf 'verify: FAIL: required M6 frontend command is unavailable: pnpm\n' >&2
    exit 1
  else
    printf 'verify: pnpm --dir app install --frozen-lockfile\n'
    pnpm --dir app install --frozen-lockfile

    printf 'verify: pnpm --dir app run format:check\n'
    pnpm --dir app run format:check

    printf 'verify: pnpm --dir app run lint\n'
    pnpm --dir app run lint

    printf 'verify: pnpm --dir app run typecheck\n'
    pnpm --dir app run typecheck

    printf 'verify: pnpm --dir app run test\n'
    pnpm --dir app run test
  fi
fi

# --- M10: offline sidecar manifest + version alignment -----------------------

if [[ -x scripts/fetch-sidecars ]]; then
  printf 'verify: ./scripts/fetch-sidecars --check\n'
  ./scripts/fetch-sidecars --check
fi

printf 'verify: ./scripts/test-distribution-contracts\n'
./scripts/test-distribution-contracts

m10_version='0.1.0'

if [[ -f app/src-tauri/tauri.conf.json ]]; then
  rg -Fq "\"version\": \"${m10_version}\"" app/src-tauri/tauri.conf.json \
    || fail "tauri.conf.json version must be ${m10_version}"
fi

if [[ -f crates/project-app/Cargo.toml ]]; then
  rg -Fq "version = \"${m10_version}\"" crates/project-app/Cargo.toml \
    || fail "crates/project-app/Cargo.toml version must be ${m10_version}"
fi

if [[ -f app/src-tauri/Cargo.toml ]]; then
  rg -Fq "version = \"${m10_version}\"" app/src-tauri/Cargo.toml \
    || fail "app/src-tauri/Cargo.toml version must be ${m10_version}"
fi

printf 'verify: M10 version alignment: %s\n' "$m10_version"

# --- UX_REDESIGN_01: closure gate ---------------------------------------------

require_file docs/ux-redesign-01/RESULTS.md
require_file docs/ux-redesign-01/harness/run.sh
require_heading docs/ux-redesign-01/RESULTS.md '## Per-flow assertion matrix'
require_file docs/decisions/0014-durable-conversation-history-in-project-aggregate.md
require_file docs/decisions/0015-deterministic-free-model-discovery.md

if (( failures > 0 )); then
  printf 'verify: %d UX_REDESIGN_01 contract failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'verify: UX_REDESIGN_01 contract passed\n'

# --- M6: Tauri shell check ---------------------------------------------------

if [[ -f app/src-tauri/Cargo.toml ]]; then
  if ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
    printf 'verify: FAIL: M6 Tauri check requires system package webkit2gtk4.1-devel\n' >&2
    printf '  install with: sudo dnf install webkit2gtk4.1-devel openssl-devel curl wget file libappindicator-gtk3-devel librsvg2-devel\n' >&2
    exit 1
  else
    # Real externalBin packaging is exercised by scripts/smoke-package, not verify.
    printf 'verify: cargo check --manifest-path app/src-tauri/Cargo.toml\n'
    TAURI_CONFIG='{"bundle":{"externalBin":null}}' cargo check --manifest-path app/src-tauri/Cargo.toml
  fi
fi

printf 'verify: git diff --check\n'
git diff --check

if [[ -f config/components.json ]]; then
  printf 'verify: M10 contract passed\n'
elif [[ -f app/src/messages.ts && -f app/src/guidance.ts ]]; then
  printf 'verify: M9 contract passed\n'
elif [[ -f crates/project-preview/tests/preview_security.rs ]]; then
  printf 'verify: M8 contract passed\n'
elif [[ -f crates/project-provider/tests/provider_security.rs ]]; then
  printf 'verify: M7 contract passed\n'
elif [[ -f app/src-tauri/Cargo.toml ]]; then
  printf 'verify: M6 contract passed\n'
elif [[ -f crates/project-agent/tests/agent_lifecycle.rs ]]; then
  printf 'verify: M5 contract passed\n'
elif [[ -f crates/project-publication/tests/publication_tunnel.rs ]]; then
  printf 'verify: M4 contract passed\n'
elif [[ -f crates/project-publication/tests/publication_lifecycle.rs ]]; then
  printf 'verify: M3 contract passed\n'
elif [[ -f crates/project-publisher/tests/publisher_http.rs ]]; then
  printf 'verify: M2 contract passed\n'
else
  printf 'verify: M1 contract passed\n'
fi
