#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$repo_root/config/agent-models.env"

usage() {
  cat <<'EOF'
Usage: scripts/agent-launch --role ROLE --provider cursor|opencode [options]

Roles: low, medium, medium-fallback, medium-high, medium-high-fallback, high-coding, high-visual, review, high-review, high-architecture
  review/high-review use Qwen3.8 Flash / Max respectively; high-review is ESCALATION-ONLY.
  high-visual maps to Cursor Grok 4.6 High (Cursor provider only) for explicit visual-design author tasks.
Options:
  --worktree PATH  Required for --launch.
  --pane ID        Required for --launch; Herdr pane ID.
  --name NAME      Required for --launch; Herdr agent name.
  --launch         Start through Herdr with an explicit native --model argument.
  --dry-run        Resolve and verify the configured model is locally available.
  --check-config   Resolve the mapping only; offline and safe for scripts/verify.
EOF
}

role=""
provider=""
worktree=""
pane=""
name=""
mode=""

while (($#)); do
  case "$1" in
    --role) role=${2:?}; shift 2 ;;
    --provider) provider=${2:?}; shift 2 ;;
    --worktree) worktree=${2:?}; shift 2 ;;
    --pane) pane=${2:?}; shift 2 ;;
    --name) name=${2:?}; shift 2 ;;
    --launch|--dry-run|--check-config) mode=$1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agent-launch: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n $role && -n $provider && -n $mode ]] || { usage >&2; exit 2; }

case "$role/$provider" in
  low/cursor) model=$LOW_CURSOR_MODEL ;;
  low/opencode) model=$LOW_OPENCODE_MODEL ;;
  medium/cursor) model=$MEDIUM_CURSOR_MODEL ;;
  medium/opencode) model=$MEDIUM_OPENCODE_MODEL ;;
  medium-fallback/opencode) model=$MEDIUM_FALLBACK_OPENCODE_MODEL ;;
  medium-high/cursor) model=$MEDIUM_HIGH_CURSOR_MODEL ;;
  medium-high/opencode) model=$MEDIUM_HIGH_OPENCODE_MODEL ;;
  medium-high-fallback/opencode) model=$MEDIUM_HIGH_FALLBACK_OPENCODE_MODEL ;;
  high-coding/cursor) model=$HIGH_CODING_CURSOR_MODEL ;;
  high-coding/opencode) model=$HIGH_CODING_OPENCODE_MODEL ;;
  high-visual/cursor) model=$HIGH_VISUAL_CURSOR_MODEL ;;
  review/opencode) model=$REVIEW_OPENCODE_MODEL ;;
  high-review/opencode) model=$HIGH_REVIEW_OPENCODE_MODEL ;;
  high-architecture/opencode) model=$HIGH_ARCHITECTURE_OPENCODE_MODEL ;;
  *) echo "agent-launch: unsupported role/provider: $role/$provider" >&2; exit 2 ;;
esac

[[ -n $model ]] || {
  echo "agent-launch: FAIL CLOSED: $role/$provider has no configured available model" >&2
  exit 3
}

case "$model" in
  composer-2.5) model_display='Composer 2.5' ;;
  cursor-grok-4.6-medium) model_display='Cursor Grok 4.6 Medium' ;;
  cursor-grok-4.6-high) model_display='Cursor Grok 4.6 High' ;;
  opencode-go/mimo-v2.5) model_display='MiMo V2.5 OpenCode Go' ;;
  opencode-go/deepseek-v4-flash) model_display='DeepSeek V4 Flash OpenCode Go' ;;
  opencode-go/qwen3.8-flash) model_display='Qwen3.8 Flash OpenCode Go' ;;
  opencode-go/qwen3.8-max) model_display='Qwen3.8 Max OpenCode Go' ;;
  opencode-go/kimi-k2.7-code) model_display='Kimi K2.7 Code OpenCode Go' ;;
  opencode-go/deepseek-v4-pro) model_display='DeepSeek V4 Pro (New) OpenCode Go' ;;
  *) echo "agent-launch: FAIL CLOSED: no active-model display matcher for $model" >&2; exit 3 ;;
esac

if [[ $mode != --check-config && $provider == cursor ]]; then
  cursor-agent models | awk '{print $1}' | grep -Fxq "$model" || {
    echo "agent-launch: FAIL CLOSED: configured Cursor model unavailable: $model" >&2
    exit 4
  }
elif [[ $mode != --check-config ]]; then
  opencode models | awk 'NF { print $1 }' | grep -Fxq "$model" || {
    echo "agent-launch: FAIL CLOSED: configured OpenCode model unavailable: $model" >&2
    exit 4
  }
fi

print_resolution() {
  local actual="$1"
  printf 'TASK: %s\nREASONING_LEVEL: %s\nAGENT_PROVIDER: %s\nMODEL_REQUESTED: %s\nMODEL_ACTUAL: %s\nWORKTREE: %s\n' \
    "${name:-dry-run}" "$role" "$provider" "$model" "$actual" "${worktree:-dry-run}"
}

if [[ $mode == --dry-run || $mode == --check-config ]]; then
  print_resolution UNVERIFIED
  exit 0
fi

[[ -n $worktree && -n $pane && -n $name ]] || {
  echo "agent-launch: --worktree, --pane, and --name are required for --launch" >&2
  exit 2
}
[[ ${HERDR_ENV:-} == 1 ]] || {
  echo "agent-launch: must run inside a Herdr session" >&2
  exit 5
}

# Orchestrator context-budget gate: fail closed before launching any new
# worker/reviewer when the orchestrator session must rotate. This never kills
# an active worker; it only prevents starting a new one.
budget_output="$( "$repo_root/scripts/check-session-budget" 2>/dev/null )" || budget_exit=$?
budget_exit=${budget_exit:-0}
case "$budget_exit" in
  0) ;;
  1)
    echo "agent-launch: WARNING: orchestrator session budget: ${budget_output#SESSION_BUDGET: }" >&2
    ;;
  2)
    echo "agent-launch: FAIL CLOSED: ROTATE_SESSION_REQUIRED — no new bounded task may be launched" >&2
    echo "agent-launch:   finish the active task/review, capture the handoff, integrate safely," >&2
    echo "agent-launch:   close the worker/reviewer panes, update CURRENT_CHECKPOINT.md, then STOP." >&2
    exit 10
    ;;
  3)
    echo "agent-launch: FAIL CLOSED: ROTATE_SESSION_REQUIRED_HARD — no new milestone work may begin" >&2
    echo "agent-launch:   rotate the orchestrator at the next safe checkpoint." >&2
    exit 11
    ;;
  *)
    echo "agent-launch: FAIL CLOSED: orchestrator session budget unknown (check-session-budget exit $budget_exit)" >&2
    exit 12
    ;;
esac

# The native CLI receives --model at process creation. Herdr only manages the
# pane lifecycle; it never chooses a provider default for this harness.
herdr agent start "$name" --kind "$provider" --pane "$pane" -- --model "$model"

# A requested CLI argument is not sufficient evidence: wait until the provider
# UI reports the exact expected model before allowing the caller to send work.
# Any unavailable/mismatched UI state exits non-zero, so no product prompt can
# follow through this launcher.
if ! herdr pane wait-output "$pane" --match "$model_display" --source visible --lines 80 --timeout 30000 >/dev/null; then
  echo "agent-launch: FAIL CLOSED: active model did not confirm requested $model" >&2
  exit 6
fi

print_resolution "$model"
