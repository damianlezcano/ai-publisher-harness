#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

output=$(./scripts/agent-launch --role low --provider cursor --check-config)
grep -Fxq 'MODEL_REQUESTED: composer-2.5' <<<"$output"
grep -Fxq 'MODEL_ACTUAL: UNVERIFIED' <<<"$output"

output=$(./scripts/agent-launch --role low --provider opencode --check-config)
grep -Fxq 'MODEL_REQUESTED: opencode-go/mimo-v2.5' <<<"$output"
grep -Fxq 'MODEL_ACTUAL: UNVERIFIED' <<<"$output"

for spec in \
  'medium opencode opencode-go/deepseek-v4-flash' \
  'medium-fallback opencode opencode-go/qwen3.8-flash' \
  'medium-high opencode opencode-go/deepseek-v4-flash' \
  'medium-high-fallback opencode opencode-go/kimi-k2.7-code' \
  'high-coding opencode opencode-go/kimi-k2.7-code' \
  'high-coding-luna opencode opencode-go/gpt-5.6-luna' \
  'review opencode opencode-go/qwen3.8-flash' \
  'high-review opencode opencode-go/qwen3.8-max' \
  'high-architecture opencode opencode-go/deepseek-v4-pro'; do
  read -r role provider expected <<<"$spec"
  output=$(./scripts/agent-launch --role "$role" --provider "$provider" --check-config)
  grep -Fxq "MODEL_REQUESTED: $expected" <<<"$output"
  grep -Fxq 'MODEL_ACTUAL: UNVERIFIED' <<<"$output"
done

output=$(./scripts/agent-launch --role medium-high --provider cursor --check-config)
grep -Fxq 'MODEL_REQUESTED: cursor-grok-4.6-medium' <<<"$output"
grep -Fxq 'MODEL_ACTUAL: UNVERIFIED' <<<"$output"
