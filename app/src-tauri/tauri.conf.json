{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EducAI",
  "version": "0.1.0",
  "identifier": "com.educai.publisher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EducAI",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm",
      "nsis"
    ],
    "useLocalToolsDir": true,
    "externalBin": [
      "../../sidecars/opencode",
      "../../sidecars/cloudflared"
    ],
    "resources": {
      "../../sidecars/onnxruntime.dll": "onnxruntime.dll",
      "../../sidecars/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll"
    },
    "category": "Education",
    "shortDescription": "Asistente educativo con IA para crear y compartir materiales.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
